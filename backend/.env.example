DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/mitraai
CORS_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=mitraai_session
SESSION_TTL_DAYS=7
# Must be true when served over HTTPS
COOKIE_SECURE=false

# Local Ollama, never exposed to the browser
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHAT_CONTEXT_MESSAGES=20
CHAT_REQUESTS_PER_MINUTE=20

# Document processing and RAG
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=200
MAX_DOCUMENT_CHUNKS=500
EMBED_BATCH_SIZE=32
CHUNK_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6
